{
  "name": "laser-pix",
  "productName": "Laser Pix",
  "version": "1.0.0",
  "description": "Préparation d'images pour la gravure laser (PNG tramé et SVG)",
  "main": "src/main.js",
  "author": "Laser Pix",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.laserpix.app",
    "productName": "Laser Pix",
    "copyright": "© 2026 Laser Pix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "config.json",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Laser-Pix-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Laser Pix",
      "language": "1036"
    }
  }
}